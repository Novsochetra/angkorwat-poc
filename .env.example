# PostHog browser analytics
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://us.i.posthog.com

# The site's address, for search and share tags (src/seo/vitePlugin.ts)
SITE_URL=https://angkor.example.com

# The bug button's tracker tickets (src/feedback/tracker.ts; dev server only, never in the build).
# A token from the tracker: Connect Claude Code → API tokens → Create token. Empty: no tickets.
TRACKER_TOKEN=
# The tracker's address (this is the default) and project (default AWP).
TRACKER_URL=https://project-tracker-production-aa4f.up.railway.app
# TRACKER_PROJECT=AWP
